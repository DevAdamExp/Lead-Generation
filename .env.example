# Lead-Generator .env
# Copy to .env and edit. All default values work for local dev.

# Database — SQLite default (change to postgresql for prod)
DATABASE_URL=sqlite+aiosqlite:///./leads.db
SYNC_DATABASE_URL=sqlite:///./leads.db

# Redis — must be running (docker-compose starts it automatically)
REDIS_URL=redis://localhost:6379/0

# Scraping tuning
# SCRAPER_HEADLESS=true keeps all browser automation invisible (no popup windows).
# Set to false only when debugging scrapers locally.
SCRAPER_HEADLESS=true
HOTFROG_REQUEST_DELAY=1.5
MAPS_REQUEST_DELAY_MIN=2.0
MAPS_REQUEST_DELAY_MAX=4.0
WEBSITE_CONCURRENCY=8
CONTACT_CONCURRENCY=4

# Proxy Rotation (multi-IP via Tor)
# More instances = more distinct exit IPs (helps Google Maps rate-limits; does NOT
# unblock Cloudflare/PerimeterX sources — those need EXTERNAL_SOCKS_PROXIES below).
# Launch with:  ./scripts/start_tor_instances.sh 5   (then match the ports here)
# Comma-separated Tor SOCKS ports
TOR_SOCKS_PORTS=9050,9150,9250,9350,9450
# Comma-separated Tor control ports (must match SOCKS ports order)
TOR_CONTROL_PORTS=9051,9151,9251,9351,9451
# External SOCKS5 proxies (alternative to Tor, comma-separated)
# EXTERNAL_SOCKS_PROXIES=socks5://user:pass@proxy1:1080,socks5://user:pass@proxy2:1080
# Auto-rotate IP every N requests (0=disabled)
IP_ROTATE_EVERY_N_REQUESTS=5

# Debug
DEBUG=false

# ── Optional: External proxy list (comma-separated SOCKS5 URLs) ─────────
# EXTERNAL_SOCKS_PROXIES=socks5://user:pass@proxy1:1080,socks5://user:pass@proxy2:1080

# ── Optional enrichment (all off by default; the core pipeline needs no keys) ──
# Per-lead pitch research and LLM gap-filling. Provider "auto" uses NVIDIA when a
# key is set, otherwise a local Ollama model.
ENABLE_PITCH_RESEARCH=false
ENABLE_LLM_EXTRACTION=false
RESEARCH_PROVIDER=auto
NVIDIA_API_KEY=            # free key from build.nvidia.com (40 req/min)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Legal-entity lookup
ENABLE_REGISTRATION_LOOKUP=false
SAM_API_KEY=               # free key from sam.gov
OPENCORPORATES_API_KEY=    # optional; keyless works but is rate-limited

# Worst-first review harvesting (adds a Maps visit per delivered lead)
ENABLE_REVIEW_SCRAPE=false
